<%= form_with(model: variable) do |form| %>
  <% if variable.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(variable.errors.count, "error") %> impidieron guardar:</h5>
      <ul class="mb-0">
        <% variable.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div class="mb-3">
    <%= form.label :particularidad_id, class: "form-label" %>
    <%= form.select :particularidad_id, options_from_collection_for_select(Particularidad.order(:titulo), :id, :titulo), {}, class: "form-select" %>
  </div>
  <div class="mb-3">
    <%= form.label :nombre, class: "form-label" %>
    <%= form.text_field :nombre, class: "form-control" %>
  </div>
  <div class="mb-3">
    <%= form.label :descripcion, class: "form-label" %>
    <%= form.textarea :descripcion, class: "form-control", rows: 3 %>
  </div>

  <div class="mb-3">
    <%= form.submit "Guardar", class: "btn btn-primary" %>
  </div>
<% end %>
