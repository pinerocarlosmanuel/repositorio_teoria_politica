<div id="<%= dom_id pais %>">
  <div>
    <strong>Nombre:</strong> <%= pais.nombre %>
  </div>

  <div>
    <strong>Continente:</strong> <%= t("enums.pais.continente.#{pais.continente}") %>
  </div>

  <div>
    <strong>Región:</strong> <%= pais.region %>
  </div>

  <div>
    <strong>Descripción:</strong> <%= pais.descripcion %>
  </div>

  <div>
    <strong>Destacado:</strong> <%= pais.destacado %>
  </div>

</div>
