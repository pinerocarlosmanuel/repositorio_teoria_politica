<p style="color: green"><%= notice %></p>

<% content_for :title, "Chat logs" %>

<h1>Chat logs</h1>

<div id="chat_logs">
  <% @chat_logs.each do |chat_log| %>
    <%= render chat_log %>
    <p>
      <%= link_to "Show this chat log", chat_log %>
    </p>
  <% end %>
</div>

<%= link_to "New chat log", new_chat_log_path %>
