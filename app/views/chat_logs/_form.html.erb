<%= form_with(model: chat_log) do |form| %>
  <% if chat_log.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(chat_log.errors.count, "error") %> prohibited this chat_log from being saved:</h2>

      <ul>
        <% chat_log.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
