<div id="<%= dom_id indicador %>">
  <div>
    <strong>Nombre:</strong> <%= indicador.nombre %>
  </div>

  <div>
    <strong>Descripción:</strong> <%= indicador.descripcion %>
  </div>

  <div>
    <strong>Método de cálculo:</strong> <%= indicador.metodo %>
  </div>

  <div>
    <strong>Variable:</strong> <%= indicador.variable&.nombre %>
  </div>

</div>
