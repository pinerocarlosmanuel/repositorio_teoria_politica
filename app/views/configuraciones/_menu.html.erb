<% valores = Configuracion.valores("menu") %>

<div class="card mb-4">
  <div class="card-body">
    <h2 class="h5 fw-bold">Menú principal</h2>
    <p class="text-muted small">Etiqueta y URL de cada elemento del menú. Deja la etiqueta en blanco para ocultarlo. Reordena con las flechas.</p>

    <%= form_with url: configuraciones_path, method: :patch, scope: :configuracion do |form| %>
      <%= hidden_field_tag "configuracion[clave]", "menu" %>

      <div class="mb-3">
        <label class="form-label small fw-semibold">Logo del menú (URL, opcional)</label>
        <%= text_field_tag "configuracion[valor][menu_logo]", valores[:menu_logo], class: "form-control form-control-sm" %>
      </div>

      <div id="menu-items">
        <% (valores[:items] || []).each do |item| %>
          <div class="menu-item-row row g-2 mb-2">
            <div class="col-md-5">
              <input type="text" name="configuracion[valor][items][][label]" value="<%= item[:label] %>"
                     class="form-control form-control-sm" placeholder="Etiqueta">
            </div>
            <div class="col-md-5">
              <input type="text" name="configuracion[valor][items][][url]" value="<%= item[:url] %>"
                     class="form-control form-control-sm" placeholder="URL (por ejemplo /conceptos)">
            </div>
            <div class="col-md-2 d-flex gap-1 align-items-center">
              <button type="button" data-menu-up class="btn btn-sm btn-outline-secondary" title="Subir">&#8593;</button>
              <button type="button" data-menu-down class="btn btn-sm btn-outline-secondary" title="Bajar">&#8595;</button>
              <button type="button" data-menu-remove class="btn btn-sm btn-outline-danger" title="Quitar">&times;</button>
            </div>
          </div>
        <% end %>
      </div>

      <template id="menu-item-template">
        <div class="menu-item-row row g-2 mb-2">
          <div class="col-md-5">
            <input type="text" name="configuracion[valor][items][][label]" class="form-control form-control-sm" placeholder="Etiqueta">
          </div>
          <div class="col-md-5">
            <input type="text" name="configuracion[valor][items][][url]" class="form-control form-control-sm" placeholder="URL (por ejemplo /conceptos)">
          </div>
          <div class="col-md-2 d-flex gap-1 align-items-center">
            <button type="button" data-menu-up class="btn btn-sm btn-outline-secondary" title="Subir">&#8593;</button>
            <button type="button" data-menu-down class="btn btn-sm btn-outline-secondary" title="Bajar">&#8595;</button>
            <button type="button" data-menu-remove class="btn btn-sm btn-outline-danger" title="Quitar">&times;</button>
          </div>
        </div>
      </template>

      <button type="button" id="add-menu-item" class="btn btn-outline-primary btn-sm mb-3">+ Añadir elemento</button>

      <div class="mt-2">
        <%= form.submit "Guardar menú", class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var contenedor = document.getElementById("menu-items");
    var plantilla = document.getElementById("menu-item-template");
    var agregar = document.getElementById("add-menu-item");
    if (!contenedor || !plantilla || !agregar) return;

    agregar.addEventListener("click", function () {
      contenedor.appendChild(plantilla.content.cloneNode(true));
    });

    contenedor.addEventListener("click", function (e) {
      var boton = e.target.closest("[data-menu-remove],[data-menu-up],[data-menu-down]");
      if (!boton) return;
      var fila = boton.closest(".menu-item-row");
      if (boton.dataset.menuRemove) { fila.remove(); }
      if (boton.dataset.menuUp && fila.previousElementSibling) {
        contenedor.insertBefore(fila, fila.previousElementSibling);
      }
      if (boton.dataset.menuDown && fila.nextElementSibling) {
        contenedor.insertBefore(fila.nextElementSibling, fila);
      }
    });
  });
</script>