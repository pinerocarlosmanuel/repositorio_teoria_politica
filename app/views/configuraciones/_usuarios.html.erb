<div class="row g-4">
  <div class="col-lg-5">
    <div class="card mb-4">
      <div class="card-body">
        <h2 class="h5 fw-bold">Nuevo usuario</h2>
        <p class="text-muted small">Crea una cuenta con su rol (visitante, editor o administrador).</p>

        <%= form_with url: configuraciones_usuarios_path, scope: :user do |form| %>
          <div class="mb-2">
            <%= form.label :email, "Correo", class: "form-label small fw-semibold" %>
            <%= form.email_field :email, class: "form-control form-control-sm", required: true %>
          </div>
          <div class="mb-2">
            <%= form.label :nombre, "Nombre", class: "form-label small fw-semibold" %>
            <%= form.text_field :nombre, class: "form-control form-control-sm" %>
          </div>
          <div class="mb-2">
            <%= form.label :rol, "Rol", class: "form-label small fw-semibold" %>
            <%= form.select :rol,
                            User.rols.keys.map { |r| [I18n.t("roles.#{r}", default: r.capitalize), r] },
                            {}, class: "form-select form-select-sm" %>
          </div>
          <div class="mb-2">
            <%= form.label :password, "Contraseña", class: "form-label small fw-semibold" %>
            <%= form.password_field :password, class: "form-control form-control-sm", required: true %>
          </div>
          <div class="mb-3">
            <%= form.label :password_confirmation, "Confirmar contraseña", class: "form-label small fw-semibold" %>
            <%= form.password_field :password_confirmation, class: "form-control form-control-sm", required: true %>
          </div>
          <%= form.submit "Crear usuario", class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card mb-4">
      <div class="card-body">
        <h2 class="h5 fw-bold">Usuarios del repositorio</h2>
        <div class="table-responsive">
          <table class="table table-sm align-middle">
            <thead>
              <tr><th>Nombre</th><th>Correo</th><th>Rol</th><th></th></tr>
            </thead>
            <tbody>
              <% User.order(:rol, :email).each do |usuario| %>
                <tr>
                  <td><%= usuario.nombre.presence || "—" %></td>
                  <td><%= usuario.email %></td>
                  <td>
                    <%= form_with url: configuracion_usuario_path(usuario), method: :patch, scope: :user, class: "d-flex gap-1" do |form| %>
                      <%= form.select :rol,
                                      User.rols.keys.map { |r| [I18n.t("roles.#{r}", default: r.capitalize), r] },
                                      { selected: usuario.rol },
                                      class: "form-select form-select-sm",
                                      disabled: usuario == current_user %>
                      <%= form.submit "Cambiar", class: "btn btn-sm btn-outline-primary", disabled: usuario == current_user %>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <% unless usuario == current_user %>
                      <%= button_to "Eliminar", configuracion_usuario_path(usuario), method: :delete,
                                    class: "btn btn-sm btn-outline-danger",
                                    data: { turbo_confirm: "¿Eliminar a #{usuario.email}?", confirm: "¿Eliminar a #{usuario.email}?" } %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>