<div class="card mb-4">
  <div class="card-body">
    <h2 class="h5 fw-bold">Enlaces dentro de las secciones</h2>
    <p class="text-muted small">Vínculos que se muestran dentro de cada página pública.</p>

    <%= form_with url: enlaces_path, scope: :enlace do |form| %>
      <div class="row g-2 align-items-end">
        <div class="col-md-3">
          <label class="form-label small fw-semibold">Sección</label>
          <%= form.collection_select :seccion_id, Seccion.order(:clave), :id, :titulo, { include_blank: true },
                                     class: "form-select form-select-sm", required: true %>
        </div>
        <div class="col-md-2">
          <label class="form-label small fw-semibold">Título</label>
          <%= form.text_field :titulo, class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-3">
          <label class="form-label small fw-semibold">URL</label>
          <%= form.text_field :url, class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-2">
          <label class="form-label small fw-semibold">Descripción</label>
          <%= form.text_field :descripcion, class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-1">
          <label class="form-label small fw-semibold">Orden</label>
          <%= form.number_field :orden, value: 0, class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-1">
          <%= form.submit "Añadir", class: "btn btn-primary btn-sm w-100" %>
        </div>
      </div>
    <% end %>

    <div class="table-responsive mt-3">
      <table class="table table-sm align-middle">
        <thead>
          <tr><th>Sección</th><th>Título</th><th>URL</th><th></th></tr>
        </thead>
        <tbody>
          <% Enlace.order(:seccion_id, :orden, :titulo).each do |enlace| %>
            <tr>
              <td><%= enlace.seccion&.titulo %></td>
              <td><%= enlace.titulo %></td>
              <td><small><%= link_to enlace.url, enlace.url, target: "_blank", rel: "noopener" %></small></td>
              <td class="text-end d-flex gap-1 justify-content-end">
                <%= link_to "Editar", edit_enlace_path(enlace), class: "btn btn-sm btn-outline-primary" %>
                <%= button_to "Eliminar", enlace_path(enlace), method: :delete,
                              class: "btn btn-sm btn-outline-danger",
                              data: { turbo_confirm: "¿Eliminar este enlace?", confirm: "¿Eliminar este enlace?" } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>