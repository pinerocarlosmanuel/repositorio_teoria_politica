<% valores = Configuracion.valores("portada") %>

<div class="card mb-4">
  <div class="card-body">
    <h2 class="h5 fw-bold">Página principal del repositorio</h2>
    <p class="text-muted small">Texto de bienvenida que se muestra en la portada.</p>

    <%= form_with url: configuraciones_path, method: :patch, scope: :configuracion do |form| %>
      <%= hidden_field_tag "configuracion[clave]", "portada" %>

      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label small fw-semibold">Título de la portada</label>
          <%= text_field_tag "configuracion[valor][titulo]", valores[:titulo], class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-6">
          <label class="form-label small fw-semibold">Subtítulo</label>
          <%= text_field_tag "configuracion[valor][subtitulo]", valores[:subtitulo], class: "form-control form-control-sm" %>
        </div>
        <div class="col-12">
          <label class="form-label small fw-semibold">Descripción</label>
          <%= text_area_tag "configuracion[valor][descripcion]", valores[:descripcion], rows: 4, class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-semibold">Texto del botón</label>
          <%= text_field_tag "configuracion[valor][cta_label]", valores[:cta_label], class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-semibold">Destino del botón (URL)</label>
          <%= text_field_tag "configuracion[valor][cta_url]", valores[:cta_url], class: "form-control form-control-sm" %>
        </div>
        <div class="col-md-4">
          <label class="form-label small fw-semibold">Debajo del botón</label>
          <%= text_field_tag "configuracion[valor][imagen_fondo]", valores[:imagen_fondo], class: "form-control form-control-sm", placeholder: "URL de imagen de fondo (opcional)" %>
        </div>
        <div class="col-12">
          <div class="form-check">
            <%= hidden_field_tag "configuracion[valor][mostrar_carrusel]", "0" %>
            <%= check_box_tag "configuracion[valor][mostrar_carrusel]", "1", valores[:mostrar_carrusel] == "1", class: "form-check-input" %>
            <label class="form-check-label small">Mostrar las comunidades / colecciones en la portada</label>
          </div>
        </div>
      </div>

      <div class="mt-3">
        <%= form.submit "Guardar cambios", class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </div>
</div>