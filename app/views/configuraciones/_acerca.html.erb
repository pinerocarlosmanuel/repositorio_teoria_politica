<div class="card mb-4">
  <div class="card-body">
    <h2 class="h5 fw-bold">Acerca de nosotros</h2>
    <p class="text-muted small">El contexto del sitio se edita como secciones públicas, igual que en el panel de administración. La pestaña "Menú" decide si aparece o no en la barra de navegación.</p>

    <div class="list-group list-group-flush">
      <% Seccion.order(:titulo).each do |seccion| %>
        <%= link_to edit_seccion_path(seccion), class: "list-group-item list-group-item-action d-flex justify-content-between align-items-center" do %>
          <span>
            <strong><%= seccion.titulo %></strong>
            <span class="text-muted small ms-2"><%= seccion.cuerpo.presence || "Sin descripción" %></span>
          </span>
          <span class="badge text-bg-secondary">Editar</span>
        <% end %>
      <% end %>
    </div>

    <div class="mt-3 d-flex gap-2">
      <%= link_to "Administrar secciones", secciones_path, class: "btn btn-outline-primary btn-sm" %>
      <%= link_to "Gestión de enlaces", enlaces_path, class: "btn btn-outline-secondary btn-sm" %>
    </div>
  </div>
</div>