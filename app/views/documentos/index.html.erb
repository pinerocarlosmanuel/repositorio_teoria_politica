<% content_for :title, "Documentos" %>

<div class="row">
  <div class="col-lg-9">
    <div class="dspace-content p-4">
      <div class="dspace-migas">
        <%= link_to "Repositorio Teoría Política", root_path %> · Documentos
      </div>

      <div class="d-flex justify-content-between align-items-center mb-2">
        <h1 class="h3 fw-bold mb-0">Documentos</h1>
        <% if current_user&.editor? || current_user&.admin? %>
          <%= link_to "Nuevo documento", new_documento_path, class: "btn btn-primary btn-sm" %>
        <% end %>
      </div>

      <% if params[:autor].present? || params[:decada].present? || params[:tipo].present? || params[:q].present? %>
        <p class="small mb-2">
          Filtros activos:
          <% if params[:q].present? %><span class="badge bg-secondary">búsqueda: <%= params[:q] %></span><% end %>
          <% if params[:autor].present? %><span class="badge bg-secondary">autor: <%= params[:autor] %></span><% end %>
          <% if params[:decada].present? %><span class="badge bg-secondary">fecha: <%= params[:decada] %></span><% end %>
          <% if params[:tipo].present? %><span class="badge bg-secondary"><%= t("enums.documento.tipo.#{params[:tipo]}") %></span><% end %>
          <%= link_to "Limpiar filtros", documentos_path, class: "ms-2" %>
        </p>
      <% end %>

      <p class="text-muted small mb-2">
        Ordenar por:
        <%= link_to "Fecha de publicación", documentos_path(orden: "anio", **filtros_activos) %> ·
        <%= link_to "Título", documentos_path(orden: "titulo", **filtros_activos) %> ·
        <%= link_to "Autor", documentos_path(orden: "autores", **filtros_activos) %>
      </p>

      <p class="fw-bold">Resultados <%= @documentos.size %> de <%= @total %></p>

      <% if @documentos.any? %>
        <table class="dspace-resultados-tabla">
          <thead>
            <tr>
              <th style="width: 12%">Fecha de publicación</th>
              <th>Título</th>
              <th style="width: 30%">Autor(es)</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            <% @documentos.each do |d| %>
              <tr>
                <td class="dspace-fecha"><%= d.anio || "s/f" %></td>
                <td>
                  <%= link_to d.titulo, d, class: "dspace-titulo" %>
                  <% if d.resumen.present? %>
                    <div class="dspace-resumen"><%= truncate(d.resumen, length: 180) %></div>
                  <% end %>
                  <% if d.archivo.attached? && puede_descargar?(d) %>
                    <div class="small mt-1">
                      <span class="badge bg-secondary"><%= formato_adjunto(d.archivo) %></span>
                      <%= link_to "Descargar (#{number_to_human_size(d.archivo.byte_size)})", descargar_documento_path(d) %>
                    </div>
                  <% end %>
                </td>
                <td class="dspace-autores"><%= d.autores %></td>
                <td class="text-end">
                  <div class="d-flex justify-content-end gap-1">
                    <%= link_to "Ver", d, class: "btn btn-sm btn-outline-primary" %>
                    <% if current_user&.editor? || current_user&.admin? %>
                      <%= link_to "Editar", edit_documento_path(d), class: "btn btn-sm btn-outline-secondary" %>
                      <%= button_to "Eliminar", d, method: :delete,
                          form: { class: "d-inline mb-0" },
                          data: { turbo_confirm: "¿Eliminar el documento '#{d.titulo}'?" },
                          class: "btn btn-sm btn-outline-danger" %>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% else %>
        <p class="text-muted">No hay documentos que coincidan con los filtros.</p>
      <% end %>
    </div>
  </div>

  <div class="col-lg-3">
    <%= render "shared/descubrir" %>
  </div>
</div>
