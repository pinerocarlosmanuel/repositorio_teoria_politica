<p style="color: green"><%= notice %></p>

<% d = @documento %>
<div class="dspace-content p-4">
  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div class="dspace-migas">
      <%= link_to "Repositorio Teoría Política", root_path %> ·
      <%= link_to "Documentos", documentos_path %> · <%= d.titulo %>
    </div>

    <div class="d-flex align-items-center gap-2">
      <% if current_user&.editor? || current_user&.admin? %>
        <%= link_to "Editar", edit_documento_path(d), class: "btn btn-outline-secondary btn-sm" %>
        <%= button_to "Eliminar", d, method: :delete,
            form: { class: "d-inline mb-0" },
            data: { turbo_confirm: "¿Eliminar el documento '#{d.titulo}'?" },
            class: "btn btn-outline-danger btn-sm" %>
      <% end %>
    </div>
  </div>

  <h1 class="h3 fw-bold mb-1"><%= d.titulo %></h1>
  <div class="small text-muted mb-3">
    <span class="badge bg-secondary"><%= t("enums.documento.tipo.#{d.tipo}") %></span>
    <% if d.anio.present? %> <span><%= d.anio %></span><% end %>
    <span> · <%= t("enums.documento.estado.#{d.estado}") %></span>
  </div>

  <% if d.autores.present? %>
    <div class="mb-2"><strong>Autor(es):</strong> <%= d.autores %></div>
  <% end %>

  <% if d.resumen.present? %>
    <div class="mb-3 p-3 bg-light border rounded">
      <strong>Resumen</strong>
      <p class="mb-0 mt-1"><%= simple_format d.resumen %></p>
    </div>
  <% end %>

  <% if d.referencia.present? %>
    <div class="mb-2"><strong>Referencia:</strong> <%= d.referencia %></div>
  <% end %>
  <% if d.doi.present? %>
    <div class="mb-2"><strong>DOI:</strong> <%= d.doi %></div>
  <% end %>
  <% if d.url.present? %>
    <div class="mb-2"><strong>URL:</strong> <%= link_to d.url, d.url, target: "_blank", rel: "noopener" %></div>
  <% end %>

  <% if d.archivo.attached? && puede_descargar?(d) %>
    <div class="mt-3">
      <%= link_to "Descargar #{etiqueta_adjunto(d.archivo)}", descargar_documento_path(d), class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= link_to "← Volver a documentos", documentos_path, class: "btn btn-outline-primary btn-sm" %>
  </div>
</div>