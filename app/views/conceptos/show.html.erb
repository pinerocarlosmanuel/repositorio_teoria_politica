<p style="color: green"><%= notice %></p>

<% c = @concepto %>
<div class="dspace-content p-4">
  <div class="dspace-migas">
    <%= link_to "Repositorio Teoría Política", root_path %> ·
    <%= link_to "Conceptos", conceptos_path %> · <%= c.termino %>
  </div>

  <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h3 fw-bold mb-0"><%= c.termino %></h1>
    <% if current_user&.editor? || current_user&.admin? %>
      <div class="d-flex align-items-center gap-2">
        <%= link_to "Editar", edit_concepto_path(c), class: "btn btn-primary btn-sm" %>
        <%= button_to "Eliminar", c, method: :delete,
            form: { class: "d-inline mb-0" },
            data: { turbo_confirm: "¿Eliminar el concepto '#{c.termino}'?" },
            class: "btn btn-outline-danger btn-sm" %>
      </div>
    <% end %>
  </div>

  <div class="mb-3 mt-2">
    <div class="mb-2"><strong>Definición:</strong> <%= simple_format c.definicion %></div>
    <% if c.sinonimos.present? %>
      <div class="mb-2"><strong>Sinónimos:</strong> <%= c.sinonimos %></div>
    <% end %>
    <% if c.categoria.present? %>
      <div class="mb-2"><strong>Categoría:</strong> <%= c.categoria %></div>
    <% end %>
    <div class="mb-2"><strong>Tema:</strong> <%= c.tema&.nombre %></div>
    <div class="mb-2"><strong>Estado:</strong> <%= t("enums.concepto.estado.#{c.estado}") %></div>
    <% if c.fuente.present? %>
      <div class="mb-2"><strong>Fuente:</strong> <%= c.fuente %></div>
    <% end %>
  </div>

  <% if c.archivo.attached? && puede_descargar?(c) %>
    <div class="mb-4">
      <span class="badge bg-secondary"><%= formato_adjunto(c.archivo) %></span>
      <%= link_to "Descargar (#{number_to_human_size(c.archivo.byte_size)})", descargar_concepto_path(c), class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>

  <h2 class="h5 fw-bold border-bottom pb-2 mt-4">Enlaces de interés</h2>
  <% if c.enlace_conceptos.ordenados.any? %>
    <ul class="list-group mb-3">
      <% c.enlace_conceptos.ordenados.each do |enlace| %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= link_to enlace.titulo, enlace.url, target: "_blank", rel: "noopener" %>
          <span class="small text-muted"><%= enlace.url %></span>
          <% if current_user&.editor? || current_user&.admin? %>
            <%= button_to "Eliminar", enlace, method: :delete,
                form: { class: "d-inline mb-0" },
                data: { turbo_confirm: "¿Eliminar el enlace '#{enlace.titulo}'?" },
                class: "btn btn-sm btn-outline-danger" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-muted">Este concepto no tiene enlaces todavía.</p>
  <% end %>

  <% if current_user&.editor? || current_user&.admin? %>
    <div class="card border-secondary mb-4">
      <div class="card-header">Añadir un enlace a este concepto</div>
      <div class="card-body">
        <%= form_with model: EnlaceConcepto.new, url: concepto_enlace_conceptos_path(c) do |form| %>
          <div class="row g-2 align-items-center">
            <div class="col-md-4">
              <%= form.text_field :titulo, placeholder: "Título del enlace", class: "form-control form-control-sm" %>
            </div>
            <div class="col-md-5">
              <%= form.text_field :url, placeholder: "https://…", class: "form-control form-control-sm" %>
            </div>
            <div class="col-md-3">
              <%= form.submit "Añadir enlace", class: "btn btn-primary btn-sm" %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="mt-2">
    <%= link_to "← Volver a conceptos", conceptos_path, class: "btn btn-outline-primary btn-sm" %>
  </div>
</div>